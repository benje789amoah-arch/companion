# Committed template. Copy to `.env` and fill in real values there — this file
# is in git, so it must never carry a key.

# Port the dispatch API listens on. The web app proxies /api here in dev, and
# the rider app points EXPO_PUBLIC_API_URL at it.
PORT=4000

# Where the built web app lives, served in production (NODE_ENV=production).
# A relative path resolves against the working directory, not this file, so use
# an absolute one — or leave it unset and let the server resolve it next to
# itself, which is correct wherever it is started from.
WEB_DIST=

# Supabase Postgres. Dashboard → Project Settings → Database → Connection string
# → URI, with [YOUR-PASSWORD] replaced by the database password.
#
# Prefer the *pooled* string (host ends in .pooler.supabase.com, port 6543) for
# anything deployed: it survives many short-lived connections, which a direct
# 5432 connection on a small instance does not. Either works — the server
# disables prepared statements so the same build runs against both.
#
# This is a credential with full write access to every table. It stays on the
# server; no client bundle ever sees it.
DATABASE_URL=

# How many connections this process opens. Keep it well under the project's
# limit when more than one instance is running. Defaults to 10.
DATABASE_POOL_MAX=

# The password the first supervisor account is created with.
#
# Read once, and only when the `supervisors` table is empty — so an existing
# deployment redeploys without it, and a database that already has a desk account
# ignores it. A fresh *production* database with this unset refuses to start,
# deliberately: the account it would otherwise create can read every customer's
# address and phone number, settle any bill and delete the ledger, and it used to
# be created with the word `password`.
#
# Left blank in development the seed uses `password`, and prints the address and
# the password it used in the startup banner. Development also gets the three
# couriers and three sign-in accounts in apps/server/src/seed.ts; production gets
# neither — real couriers are hired through the supervisor desk, and real
# customers register.
SEED_SUPERVISOR_PASSWORD=

# Public origin of the deployed app. Used as the Paystack callback when a
# client does not supply its own; the website and the customer app both do.
APP_URL=

# The hub's fallback clock, in minutes per stage.
#
# Once a courier has checked bags in, the two stages that follow — In Care →
# Ironing & Folding → Quality Check — are confirmed from the supervisor desk's
# Hub tab by whoever knows the load is done. This sweep is what advances them
# when nobody has said either, on elapsed time alone.
#
# Blank means: on in development, off in production. Setting either variable
# turns it on everywhere, including in front of paying customers — which is a
# machine telling somebody their laundry is washed because a clock passed a
# number. Every advance it makes is filed in the audit trail against `system`,
# saying that nobody confirmed the work.
#
# Both default to 2 minutes, short enough to watch a job go round once.
# Fractions work — 0.1 is six seconds, for a demo.
HUB_WASH_MINUTES=
HUB_FINISH_MINUTES=

# Comma-separated origins allowed to call this API cross-origin. Left blank in
# development every origin is allowed, which is what lets a phone on the LAN
# reach it. In production a blank value blocks all cross-origin requests.
#
# This list does double duty: it is also where Paystack is allowed to return a
# customer after checkout. `/paystack/initialize` takes a `callback_url` from
# the caller and is unauthenticated, so without an allow-list anybody could mint
# a checkout on the real gateway that landed the customer on their own page the
# moment the payment settled. An origin trusted enough to call this API is
# trusted enough to be returned to; APP_URL's origin is always allowed on top,
# so a correct deployment needs nothing extra here.
CORS_ORIGINS=

# URL schemes the mobile apps are reachable on, comma-separated, for the same
# allow-list. Paystack has to be able to send a customer back into the app
# rather than to a web page the phone cannot use, and that link is
# `freshfoldclient://paystack-success` rather than an http origin.
#
# Leave blank and the customer app's scheme is allowed, plus Expo Go's `exp`
# outside production. Set it only if a build ships under a different scheme —
# see `scheme` in apps/client/app.config.js.
APP_LINK_SCHEMES=

# Outbound email — the customer email-confirmation link, the password-reset
# link, and the booking confirmation that carries the portal setup link. Riders
# and supervisors never receive email, so this is only ever needed for the
# customer apps.
#
# Leave both keys blank and nothing is sent: the link is written to the server
# log instead, which is enough to exercise the whole flow locally without
# signing up for anything.

# Brevo — used in preference to Resend when both are set. Dashboard → SMTP &
# API → API Keys (a v3 key, starts `xkeysib-`).
#
# The reason it is here: Brevo verifies a single *sender address* — Senders,
# Domains & Dedicated IPs → Senders → Add a Sender, then click the link it mails
# you — and will then send to anybody. Resend needs a whole verified domain
# before it will deliver to an address other than the account owner's, and we do
# not have one yet.
BREVO_API_KEY=

# Resend — the fallback, and still the better end state once a domain exists.
# Dashboard → API Keys.
RESEND_API_KEY=

# The From address, required once either key is set. It must be a sender the
# provider recognises: verified in Brevo's Senders list, or on a domain verified
# in Resend. Resend's shared sending domain (onboarding@resend.dev) works
# without setup but only delivers to the address that owns the Resend account —
# fine for testing, useless for customers.
#
# `Name <address>` and a bare address both parse; Brevo gets the two halves
# separately.
EMAIL_FROM="FreshFold <onboarding@resend.dev>"

# Gemini — powers the "Foldie" concierge chatbot on the website.
GEMINI_API_KEY=
# Override if you need a different model. gemini-3.6-flash is the newer stable
# release if you want to move up; gemini-3.5-flash-lite is cheaper and faster.
GEMINI_MODEL=gemini-3.5-flash

# Paystack — server-side initialize/verify for Ghana MoMo and card payments.
# The *secret* key (sk_test_… or sk_live_…). It stays on the server: the apps
# call /api/paystack/initialize and never see it.
#
# The same key signs the webhook, so no second secret is needed. Point the
# dashboard's webhook URL (Settings → API Keys & Webhooks) at
# https://<this server>/api/paystack/webhook and a wallet top-up is credited
# when the payment settles, whether or not the customer comes back to the app.
# Paystack cannot reach localhost — for local testing, tunnel it, or rely on
# the "I have paid" button, which verifies the same reference by hand.
PAYSTACK_SECRET_KEY=

# Google Maps Platform, with the Routes API *and* the Places API (New)
# enabled. Used server-side only: /api/directions computes each leg once and
# hands the road geometry to all three apps, and /api/places answers the
# booking forms' address lookup — so this key never ships in a client bundle.
# Leave it blank and every map falls back to drawing a straight line, and
# address lookup falls back to FreshFold's own hostel list, which needs no key.
#
# Keep this separate from the browser key in apps/web/.env — that one is public
# by design, and a Routes-enabled key must never be readable in a page.
GOOGLE_MAPS_PLATFORM_KEY=

# How many reverse proxies sit in front of this process. /api/directions is
# open (guest order tracking needs it to be) and rate-limits per client IP, so
# behind a proxy this must be set or every request looks like it came from the
# proxy and shares one bucket. Usually `1`. Leave it blank when nothing is in
# front: trusting X-Forwarded-For with no proxy to strip it lets a caller forge
# an IP per request and skip the limiter entirely.
TRUST_PROXY=
