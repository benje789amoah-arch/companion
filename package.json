{
  "name": "freshfold",
  "version": "1.0.0",
  "private": true,
  "description": "FreshFold Laundry Co. — customer web app, rider companion app, and the shared dispatch backend they both talk to.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @freshfold/server",
    "dev:web": "npm run dev --workspace @freshfold/web",
    "mobile": "npm run start --workspace @freshfold/mobile",
    "build": "npm run build --workspace @freshfold/web && npm run build --workspace @freshfold/server",
    "start": "npm run start --workspace @freshfold/server",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
